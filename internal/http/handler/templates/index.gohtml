<!doctype html>
<html>
<head>
    <h1>All metrics</h1>
</head>
<body>
    <table>
        <thead>
            <tr>
                <th>Name</th><th>Type</th><th>Value</th>
            </tr>
        </thead>
        <tbody>
            {{- range . -}}
            <tr>
                <td>{{- .ID -}}</td>
                <td>{{- .MType -}}</td>
                <td>
                    {{- if .Value -}}
                        {{- .Value -}}
                    {{- else if .Delta -}}
                        {{- .Delta -}}
                    {{- else -}}
                        N/A
                    {{- end -}}
                </td>
            </tr>
            {{- end -}}
		</tbody>
    </table>
</body>
</html>